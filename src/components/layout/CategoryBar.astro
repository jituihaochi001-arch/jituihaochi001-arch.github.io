---
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import { Icon } from "astro-icon/components";
import { getCategoryList, getSortedPostsList, type Category } from "@/utils/content-utils";
import { url } from "@/utils/url-utils";
import { worksCategories } from "@/config/worksConfig";

interface Props {
	currentPostCategory?: string;
	variant?: "default" | "works";
}

const { currentPostCategory, variant = "default" } = Astro.props as Props;

const allPosts = await getSortedPostsList();
const totalPosts = allPosts.length;

const homeUrl = url("/");
const worksUrl = url("/works/");
// 作品页的「全部」和分类都指向作品页自身，用 ?category= 在页内过滤，绝不跳到文章页。
const archiveUrl = variant === "works" ? worksUrl : url("/archive/");
const archiveLabel = variant === "works" ? i18n(I18nKey.all) : i18n(I18nKey.archive);

// 作品页按功能分类（固定顺序、含 0 计数）；其它页面沿用博客分类。
let categories: Category[];
const categoryIcons: Record<string, string> = {};
if (variant === "works") {
	const counts = new Map<string, number>();
	for (const post of allPosts) {
		const name = (post.data.category ?? "").trim();
		if (name) counts.set(name, (counts.get(name) ?? 0) + 1);
	}
	categories = worksCategories.map((c) => {
		categoryIcons[c.name] = c.icon;
		return {
			name: c.name,
			count: counts.get(c.name) ?? 0,
			url: `${worksUrl}?category=${encodeURIComponent(c.name)}`,
		};
	});
} else {
	categories = await getCategoryList();
}
---

<div
  class="card-base category-bar p-3 onload-animation"
  id="category-bar"
  data-variant={variant}
  data-home-path={homeUrl}
  data-archive-path={archiveUrl}
  data-current-post-category={currentPostCategory || ""}
>
  <div class="category-bar-inner flex gap-2">
    <a
      href={homeUrl}
      class="category-pill text-sm px-3 py-1.5 rounded-xl shrink-0
             transition-colors duration-150 ease-out flex items-center justify-center"
      data-category-name=""
      aria-label={i18n(I18nKey.home)}
    >
      <Icon is:inline name="material-symbols:home" class="text-lg" />
    </a>
    <a
      href={archiveUrl}
      class="category-pill text-sm px-4 py-1.5 rounded-xl whitespace-nowrap shrink-0
             transition-colors duration-150 ease-out flex items-center justify-center"
      data-category-name="__archive__"
      data-route-loading="inline"
    >
      {archiveLabel}
      <span class="pill-count">{totalPosts}</span>
    </a>
    <div class="category-divider shrink-0"></div>
    <div class="scroll-area relative">
      <div class="scroll-fade scroll-fade-left" aria-hidden="true"></div>
      <div class="category-scroll flex gap-2 overflow-x-auto">
        {
          categories.map((cat) => (
            <a
              href={cat.url}
              class="category-pill text-sm px-4 py-1.5 rounded-xl whitespace-nowrap
                     transition-colors duration-150 ease-out flex items-center justify-center"
              data-category-name={cat.name}
              data-route-loading="inline"
              data-empty={cat.count === 0 ? "" : undefined}
            >
              {categoryIcons[cat.name] && (
                <Icon is:inline name={categoryIcons[cat.name]} class="text-base" />
              )}
              {cat.name}
              <span class="pill-count">{cat.count}</span>
            </a>
          ))
        }
      </div>
      <div class="scroll-fade scroll-fade-right" aria-hidden="true"></div>
    </div>
    <div class="category-divider shrink-0 more-divider" aria-hidden="true"></div>
    <a
      href={url("/categories/")}
      class="category-pill text-sm px-3 py-1.5 rounded-xl shrink-0
             transition-colors duration-150 ease-out flex items-center justify-center gap-1"
      data-category-name="__categories__"
      data-route-loading="inline"
      aria-label={i18n(I18nKey.more)}
    >
      <span>{i18n(I18nKey.more)}</span>
      <Icon is:inline name="fa7-solid:chevron-right" class="text-sm" />
    </a>
  </div>
</div>

<style>
  .category-bar {
    margin-bottom: 1rem;
  }
  .category-divider {
    width: 1px;
    align-self: stretch;
    background: var(--line-divider);
    opacity: 0.5;
  }
  .more-divider {
    opacity: 0;
    transition: opacity 300ms ease-in-out;
  }
  .more-divider[data-visible] {
    opacity: 0.5;
  }
  .scroll-area {
    flex: 1;
    min-width: 0;
    position: relative;
  }
  .scroll-fade {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 2.5rem;
    pointer-events: none;
    opacity: 0;
    transition: opacity 300ms ease-in-out;
    z-index: 1;
  }
  .scroll-fade[data-visible] {
    opacity: 1;
  }
  .scroll-fade-left {
    left: 0;
    background: linear-gradient(to left, transparent, var(--card-bg));
  }
  .scroll-fade-right {
    right: 0;
    background: linear-gradient(to right, transparent, var(--card-bg));
  }
  :global(body.wallpaper-transparent) .scroll-fade {
    display: none;
  }
  .category-scroll {
    scrollbar-width: none;
    -ms-overflow-style: none;
    scroll-behavior: smooth;
  }
  .category-scroll::-webkit-scrollbar {
    display: none;
  }
  .category-pill {
    border: 1px solid var(--glass-control-border);
    color: var(--primary);
    background: transparent;
    box-shadow: none;
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
    font-weight: 500;
    gap: 0.375rem;
  }
  .category-pill .pill-count {
    font-size: 0.7rem;
    font-weight: 600;
    opacity: 0.65;
    background: transparent;
  }
  .category-pill[data-empty] {
    opacity: 0.55;
  }
  .category-pill[data-empty]:hover {
    opacity: 0.9;
  }
  .category-pill[data-category-name=""] {
    color: var(--primary);
  }
  .category-pill:hover {
    color: var(--primary);
    border-color: color-mix(in srgb, var(--primary) 36%, var(--glass-control-border));
  }
  .category-pill[data-active] {
    border-color: color-mix(in srgb, var(--primary) 55%, var(--glass-control-border));
    color: var(--primary);
    font-weight: 600;
  }
  .category-pill[data-active] .pill-count {
    opacity: 0.8;
  }
  .category-pill[data-soft-active] {
    border-color: color-mix(in srgb, var(--primary) 35%, var(--glass-control-border));
    color: var(--primary);
    font-weight: 600;
  }
  .category-pill:focus-visible {
    outline: 2px solid var(--primary);
    outline-offset: 2px;
  }
</style>

<script>
  let delayedCategoryBarScrollTimer: number | undefined;

  function getCategoryBarState(bar: HTMLElement, currentUrl: URL) {
    const pathname = currentUrl.pathname
      .replace(/\/index\.html$/, "")
      .replace(/\/$/, "");
    const homePath = (bar.getAttribute("data-home-path") || "/").replace(/\/$/, "");
    const archivePath = (bar.getAttribute("data-archive-path") || "/archive").replace(/\/$/, "");
    const isHome = pathname === homePath || pathname === "" || pathname === "/";
    const isArchive = pathname === archivePath;
    const isCategories = pathname === "/categories";

    return {
      isHome,
      isArchive,
      isCategories,
      activeCategory: currentUrl.searchParams.get("category") || "",
      hasTag: currentUrl.searchParams.has("tag"),
      hasUncategorized: currentUrl.searchParams.has("uncategorized"),
    };
  }

  function setActiveCategory(bar: HTMLElement, currentUrl: URL) {
    const { isHome, isArchive, isCategories, activeCategory, hasTag, hasUncategorized } =
      getCategoryBarState(bar, currentUrl);
    const postCategory = (bar.getAttribute("data-current-post-category") || "").trim();

    const pills = bar.querySelectorAll<HTMLAnchorElement>(".category-pill");
    pills.forEach((pill) => {
      pill.removeAttribute("data-active");
      pill.removeAttribute("data-soft-active");
    });

    if (isHome) {
      bar.querySelector<HTMLAnchorElement>('.category-pill[data-category-name=""]')
        ?.setAttribute("data-active", "");
      return;
    }

    if (isCategories) {
      bar.querySelector<HTMLAnchorElement>('.category-pill[data-category-name="__categories__"]')
        ?.setAttribute("data-active", "");
      return;
    }

    if (activeCategory) {
      pills.forEach((pill) => {
        if (pill.getAttribute("data-category-name") === activeCategory) {
          pill.setAttribute("data-active", "");
        }
      });
      return;
    }

    if (isArchive && !hasTag && !hasUncategorized) {
      bar.querySelector<HTMLAnchorElement>('.category-pill[data-category-name="__archive__"]')
        ?.setAttribute("data-active", "");
      return;
    }

    if (postCategory) {
      pills.forEach((pill) => {
        if (pill.getAttribute("data-category-name") === postCategory) {
          pill.setAttribute("data-soft-active", "");
        }
      });
    }
  }

  // 作品页的分类只是页内过滤，不跳转到文章页。这里按 ?category= 隐藏不匹配的卡片。
  function applyWorksCategoryFilter(bar: HTMLElement, currentUrl: URL) {
    if (bar.getAttribute("data-variant") !== "works") return;
    const container = document.getElementById("post-list-container");
    if (!container) return;

    const activeCategory = (currentUrl.searchParams.get("category") || "").trim();
    const cards = container.querySelectorAll<HTMLElement>(".post-card-item");
    let visibleCount = 0;

    cards.forEach((card) => {
      const category = (card.getAttribute("data-post-category") || "").trim();
      const isVisible = !activeCategory || category === activeCategory;
      card.style.display = isVisible ? "" : "none";
      if (isVisible) visibleCount += 1;
    });

    const emptyState = document.getElementById("works-empty-state");
    if (emptyState) {
      emptyState.hidden = !(activeCategory && visibleCount === 0);
    }
  }

  function scrollActiveCategoryIntoView(bar: HTMLElement, behavior: ScrollBehavior = "smooth") {
    const activePill =
      bar.querySelector<HTMLAnchorElement>('.category-pill[data-active]') ||
      bar.querySelector<HTMLAnchorElement>('.category-pill[data-soft-active]');
    const scroll = bar.querySelector<HTMLElement>(".category-scroll");
    if (!activePill || !scroll) return;

    const scrollLeft = activePill.offsetLeft - scroll.offsetLeft - (scroll.clientWidth - activePill.offsetWidth) / 2;
    scroll.scrollTo({ left: Math.max(0, scrollLeft), behavior });
  }

  function shouldDeferCategoryScroll(bar: HTMLElement, currentUrl: URL) {
    const { isHome } = getCategoryBarState(bar, currentUrl);
    const isMobile = window.innerWidth < 1024;
    const isBannerMode = document.body.classList.contains("enable-banner");
    return isMobile && isBannerMode && !isHome;
  }

  function updateCategoryBar(
    currentUrl = new URL(window.location.href),
    options: { scrollBehavior?: ScrollBehavior; deferScroll?: boolean } = {},
  ) {
    const bar = document.getElementById("category-bar");
    if (!bar) return;

    const swupContainer = document.getElementById("swup-container");
    if (swupContainer) {
      const currentPostCategory = swupContainer.getAttribute("data-current-post-category") || "";
      bar.setAttribute("data-current-post-category", currentPostCategory);
    }

    setActiveCategory(bar, currentUrl);
    applyWorksCategoryFilter(bar, currentUrl);

    const deferScroll = options.deferScroll ?? shouldDeferCategoryScroll(bar, currentUrl);
    const scrollBehavior = options.scrollBehavior ?? (deferScroll ? "auto" : "smooth");

    if (delayedCategoryBarScrollTimer) {
      window.clearTimeout(delayedCategoryBarScrollTimer);
      delayedCategoryBarScrollTimer = undefined;
    }

    if (deferScroll) {
      // 等主内容上移完成后再定位分类，避免出现“先横向滚动后上移”的卡顿观感。
      delayedCategoryBarScrollTimer = window.setTimeout(() => {
        requestAnimationFrame(() => {
          requestAnimationFrame(() => {
            scrollActiveCategoryIntoView(bar, scrollBehavior);
            updateScrollHint();
          });
        });
      }, 220);
      return;
    }

    scrollActiveCategoryIntoView(bar, scrollBehavior);
    updateScrollHint();
  }

  function initCategoryBarInteractions() {
    const bar = document.getElementById("category-bar");
    if (!bar || bar.dataset.clickBound === "true") return;

    bar.dataset.clickBound = "true";
    bar.addEventListener("click", (event) => {
      if (!(event.target instanceof Element)) return;

      const pill = event.target.closest<HTMLAnchorElement>(".category-pill");
      if (!pill) return;

      if (
        event.defaultPrevented ||
        event.button !== 0 ||
        event.metaKey ||
        event.ctrlKey ||
        event.shiftKey ||
        event.altKey
      ) {
        return;
      }

      if (pill.target && pill.target !== "_self") return;

      const targetUrl = new URL(pill.href, window.location.href);
      if (targetUrl.origin !== window.location.origin) return;

      // 作品页的分类是页内过滤，不参与路由：拦下点击，交给 Swup 之前就结束。
      // 这样既不会跳到文章页，也不会发起一次同路径 + query 的 Swup 访问。
      if (bar.getAttribute("data-variant") === "works") {
        const name = pill.getAttribute("data-category-name") || "";
        const isWorksFilterPill = name === "__archive__" || (!!name && name !== "__categories__");
        if (isWorksFilterPill) {
          event.preventDefault();
          event.stopPropagation();
          const filterUrl = new URL(window.location.href);
          if (name === "__archive__") filterUrl.searchParams.delete("category");
          else filterUrl.searchParams.set("category", name);
          setActiveCategory(bar, filterUrl);
          applyWorksCategoryFilter(bar, filterUrl);
          scrollActiveCategoryIntoView(bar, "auto");
          return;
        }
      }

      setActiveCategory(bar, targetUrl);
      scrollActiveCategoryIntoView(bar, "auto");
    });
  }

  function initScrollFeatures() {
    const bar = document.getElementById("category-bar");
    if (!bar) return;

    const scroll = bar.querySelector<HTMLElement>(".category-scroll");
    if (!scroll) return;

    if (scroll.dataset.featuresBound === "true") {
      updateScrollHint();
      return;
    }
    scroll.dataset.featuresBound = "true";

    // 鼠标滚轮横向滚动
    scroll.addEventListener("wheel", (e) => {
      if (scroll.scrollWidth <= scroll.clientWidth) return;
      e.preventDefault();
      scroll.scrollLeft += e.deltaY;
    }, { passive: false });

    // 监听滚动更新提示图标
    scroll.addEventListener("scroll", updateScrollHint);
    window.addEventListener("resize", updateScrollHint);
    updateScrollHint();
  }

  function updateScrollHint() {
    const bar = document.getElementById("category-bar");
    if (!bar) return;
    const scroll = bar.querySelector<HTMLElement>(".category-scroll");
    const fadeLeft = bar.querySelector<HTMLElement>(".scroll-fade-left");
    const fadeRight = bar.querySelector<HTMLElement>(".scroll-fade-right");
    if (!scroll || !fadeLeft || !fadeRight) return;

    const hasOverflow = scroll.scrollWidth > scroll.clientWidth + 1;
    const atStart = scroll.scrollLeft <= 1;
    const atEnd = scroll.scrollLeft + scroll.clientWidth >= scroll.scrollWidth - 1;

    if (hasOverflow && !atStart) {
      fadeLeft.setAttribute("data-visible", "");
    } else {
      fadeLeft.removeAttribute("data-visible");
    }

    if (hasOverflow && !atEnd) {
      fadeRight.setAttribute("data-visible", "");
    } else {
      fadeRight.removeAttribute("data-visible");
    }

    // 分类溢出时显示"更多"按钮前的分割线
    const moreDivider = bar.querySelector<HTMLElement>(".more-divider");
    if (moreDivider) {
      if (hasOverflow) {
        moreDivider.setAttribute("data-visible", "");
      } else {
        moreDivider.removeAttribute("data-visible");
      }
    }
  }

  updateCategoryBar();
  initCategoryBarInteractions();
  initScrollFeatures();
  document.addEventListener("astro:page-load", () => {
    updateCategoryBar();
    initCategoryBarInteractions();
    initScrollFeatures();
  });
  document.addEventListener("swup:contentReplaced", () => {
    updateCategoryBar();
    initCategoryBarInteractions();
    initScrollFeatures();
    // 某些 swup 生命周期下 URL/DOM 状态同步稍晚，下一帧再校正一次避免状态残留
    requestAnimationFrame(() => {
      updateCategoryBar();
    });
  });

  // 在 Swup 导航时提前更新状态，避免切换期间激活态闪烁
  function setupSwupEarlyUpdate() {
    if (!window.swup?.hooks) return;
    window.swup.hooks.on("visit:start", (visit: any) => {
      const bar = document.getElementById("category-bar");
      if (!bar) return;
      const targetUrl = new URL(visit.to.url, window.location.href);
      setActiveCategory(bar, targetUrl);
    });
  }
  if (window.swup?.hooks) {
    setupSwupEarlyUpdate();
  } else {
    document.addEventListener("swup:enable", setupSwupEarlyUpdate);
  }
</script>
