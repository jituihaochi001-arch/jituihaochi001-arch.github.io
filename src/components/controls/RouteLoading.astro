---
// Swup 切页间隙的小猫加载层：延迟出现、最短展示、结束淡出。
---

<div id="route-loading-overlay" class="route-loading-overlay" aria-hidden="true">
  <div class="route-loading-inner">
    <svg class="route-loading-cat" viewBox="0 0 96 96" aria-hidden="true" focusable="false">
      <ellipse class="cat-shadow" cx="48" cy="88" rx="27" ry="4.5" />
      <g class="cat-bob">
        <path class="cat-ear cat-ear--left" d="M24 34 L19 12 Q18 9 21.5 10 L41 24 Z" />
        <path class="cat-ear cat-ear--right" d="M72 34 L77 12 Q78 9 74.5 10 L55 24 Z" />
        <path class="cat-ink" d="M48 24 C64 24 78 34 78 50 C78 66 65 76 48 76 C31 76 18 66 18 50 C18 34 32 24 48 24 Z" />
        <rect class="cat-cut cat-eye" x="35" y="42" width="6.5" height="11" rx="3.25" />
        <rect class="cat-cut cat-eye" x="54.5" y="42" width="6.5" height="11" rx="3.25" />
        <path class="cat-smile" d="M43 60 Q48 65 53 60" />
        <path class="cat-tail" d="M78 62 Q92 64 88 76 Q86 82 79 81" />
      </g>
    </svg>
    <span class="route-loading-text">loading</span>
    <span class="route-loading-bar"><i></i></span>
  </div>
</div>

<script is:inline data-swup-ignore-script>
  (() => {
    const overlay = document.getElementById("route-loading-overlay");
    if (!overlay) return;

    const SHOW_DELAY = 140;
    const MIN_VISIBLE = 240;
    const MAX_VISIBLE = 8000;

    const runtime = (window.__routeLoadingRuntime ||= {
      showTimer: 0,
      hideTimer: 0,
      maxTimer: 0,
      shownAt: 0,
      active: false,
      bound: false,
      overlay: null,
    });
    runtime.overlay = overlay;
    if (runtime.active) overlay.classList.add("is-active");

    const show = () => {
      window.clearTimeout(runtime.showTimer);
      runtime.showTimer = 0;
      if (runtime.active) return;
      runtime.active = true;
      runtime.shownAt = performance.now();
      overlay.classList.add("is-active");
      window.clearTimeout(runtime.maxTimer);
      runtime.maxTimer = window.setTimeout(hide, MAX_VISIBLE);
    };

    function hide() {
      window.clearTimeout(runtime.showTimer);
      window.clearTimeout(runtime.maxTimer);
      runtime.showTimer = 0;
      if (!runtime.active) {
        overlay.classList.remove("is-active");
        return;
      }
      const remaining = MIN_VISIBLE - (performance.now() - runtime.shownAt);
      window.clearTimeout(runtime.hideTimer);
      const finish = () => {
        runtime.active = false;
        overlay.classList.remove("is-active");
      };
      if (remaining > 0) runtime.hideTimer = window.setTimeout(finish, remaining);
      else finish();
    }

    function onVisitStart() {
      window.clearTimeout(runtime.showTimer);
      runtime.showTimer = window.setTimeout(show, SHOW_DELAY);
    }

    runtime.show = show;
    runtime.hide = hide;

    if (!runtime.bound) {
      runtime.bound = true;
      const bindHooks = () => {
        if (!window.swup?.hooks) return false;
        window.swup.hooks.on("visit:start", onVisitStart);
        window.swup.hooks.on("visit:end", hide);
        window.swup.hooks.on("visit:abort", hide);
        return true;
      };
      if (!bindHooks()) {
        document.addEventListener("swup:enable", bindHooks, { once: true });
      }
      document.addEventListener("swup:page:view", hide);
      document.addEventListener("astro:page-load", hide);
    }
  })();
</script>

<style>
  .route-loading-overlay {
    position: fixed;
    inset: 0;
    z-index: 1002;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--page-bg);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition:
      opacity 160ms ease,
      visibility 0s linear 160ms;
  }

  .route-loading-overlay.is-active {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transition:
      opacity 140ms ease,
      visibility 0s;
  }

  .route-loading-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    transform: translateY(14px) scale(0.94);
    transition: transform 360ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .route-loading-overlay.is-active .route-loading-inner {
    transform: none;
  }

  .route-loading-cat {
    display: block;
    width: clamp(116px, 26vw, 158px);
    height: auto;
    overflow: visible;
  }

  .cat-ink,
  .cat-ear {
    fill: color-mix(in oklab, var(--text-color) 80%, transparent);
  }

  .cat-cut {
    fill: var(--page-bg);
  }

  .cat-smile {
    fill: none;
    stroke: var(--page-bg);
    stroke-width: 2.6;
    stroke-linecap: round;
  }

  .cat-tail {
    fill: none;
    stroke: color-mix(in oklab, var(--text-color) 80%, transparent);
    stroke-width: 6.5;
    stroke-linecap: round;
    transform-box: fill-box;
    transform-origin: 0% 4%;
    animation: route-loading-tail 1.7s cubic-bezier(0.45, 0, 0.55, 1) infinite;
  }

  .cat-bob {
    transform-box: fill-box;
    transform-origin: 50% 88%;
    animation: route-loading-bob 2.4s cubic-bezier(0.45, 0, 0.55, 1) infinite;
  }

  .cat-eye {
    transform-box: fill-box;
    transform-origin: 50% 50%;
    animation: route-loading-blink 4.6s ease-in-out infinite;
  }

  .cat-ear--left {
    transform-box: fill-box;
    transform-origin: 80% 100%;
    animation: route-loading-ear-left 5.4s ease-in-out infinite;
  }

  .cat-ear--right {
    transform-box: fill-box;
    transform-origin: 20% 100%;
    animation: route-loading-ear-right 5.4s ease-in-out infinite;
  }

  .cat-shadow {
    fill: color-mix(in oklab, var(--text-color) 14%, transparent);
    transform-box: fill-box;
    transform-origin: 50% 50%;
    animation: route-loading-shadow 2.4s cubic-bezier(0.45, 0, 0.55, 1) infinite;
  }

  .route-loading-text {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.34em;
    text-transform: lowercase;
    color: color-mix(in oklab, var(--text-color) 46%, transparent);
    animation: route-loading-text-pulse 2.4s ease-in-out infinite;
  }

  .route-loading-bar {
    position: relative;
    display: block;
    width: clamp(108px, 24vw, 136px);
    height: 9px;
    border-radius: 999px;
    overflow: hidden;
    background: color-mix(in oklab, var(--text-color) 10%, transparent);
  }

  .route-loading-bar i {
    position: absolute;
    inset: 0 auto 0 0;
    width: 38%;
    border-radius: inherit;
    background: color-mix(in oklab, var(--text-color) 80%, transparent);
    animation: route-loading-slide 1.15s cubic-bezier(0.45, 0, 0.55, 1) infinite;
  }

  .route-loading-overlay:not(.is-active)
    :is(.cat-bob, .cat-tail, .cat-eye, .cat-ear, .cat-shadow, .route-loading-text, .route-loading-bar i) {
    animation-play-state: paused;
  }

  @keyframes route-loading-bob {
    0%,
    100% {
      transform: translateY(0) scale(1, 1);
    }
    50% {
      transform: translateY(-6px) scale(1.02, 0.98);
    }
  }

  @keyframes route-loading-tail {
    0%,
    100% {
      transform: rotate(-7deg);
    }
    50% {
      transform: rotate(9deg);
    }
  }

  @keyframes route-loading-blink {
    0%,
    87%,
    95%,
    100% {
      transform: scaleY(1);
    }
    90%,
    92% {
      transform: scaleY(0.1);
    }
  }

  @keyframes route-loading-ear-left {
    0%,
    88%,
    94%,
    100% {
      transform: rotate(0deg);
    }
    91% {
      transform: rotate(-7deg);
    }
  }

  @keyframes route-loading-ear-right {
    0%,
    88%,
    94%,
    100% {
      transform: rotate(0deg);
    }
    91% {
      transform: rotate(7deg);
    }
  }

  @keyframes route-loading-shadow {
    0%,
    100% {
      transform: scale(1);
      opacity: 1;
    }
    50% {
      transform: scale(0.86);
      opacity: 0.6;
    }
  }

  @keyframes route-loading-text-pulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.55;
    }
  }

  @keyframes route-loading-slide {
    0% {
      transform: translateX(-110%);
    }
    100% {
      transform: translateX(260%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .route-loading-overlay,
    .route-loading-overlay.is-active {
      transition: none;
    }

    .route-loading-inner,
    .route-loading-overlay.is-active .route-loading-inner {
      transform: none;
      transition: none;
    }

    .cat-bob,
    .cat-tail,
    .cat-eye,
    .cat-ear,
    .cat-shadow,
    .route-loading-text,
    .route-loading-bar i {
      animation: none;
    }

    .route-loading-bar i {
      width: 60%;
    }
  }
</style>
