---
// Swup 切页加载层：整页导航用全屏小猫遮罩，标签页切换只在分类栏下方放一小堆小猫。
import RouteLoadingCats from "@/components/controls/RouteLoadingCats.astro";
---

<div id="route-loading-overlay" class="route-loading-overlay" aria-hidden="true">
  <div class="route-loading-inner">
    <RouteLoadingCats />
    <span class="route-loading-text">loading</span>
  </div>
</div>

<script is:inline data-swup-ignore-script>
  (() => {
    const overlay = document.getElementById("route-loading-overlay");
    if (!overlay) return;

    const SHOW_DELAY = 140;
    const MIN_VISIBLE = 240;
    const MAX_VISIBLE = 8000;
    const INLINE_SELECTOR = "[data-route-loading=\"inline\"]";

    const runtime = (window.__routeLoadingRuntime ||= {
      showTimer: 0,
      hideTimer: 0,
      maxTimer: 0,
      shownAt: 0,
      active: false,
      bound: false,
      mode: "overlay",
      overlay: null,
      inline: null,
    });
    runtime.overlay = overlay;
    runtime.inline = document.getElementById("route-loading-inline");

    // 小猫贴在分类栏下沿，所以量一下栏底到主列顶部的距离。
    function placeInlineVeil() {
      if (!runtime.inline) return;
      const shell = runtime.inline.parentElement;
      if (!shell) return;
      const bar = document.getElementById("category-bar-wrapper");
      const offset =
        bar && shell.contains(bar)
          ? Math.max(0, Math.round(bar.getBoundingClientRect().bottom - shell.getBoundingClientRect().top))
          : 0;
      runtime.inline.style.setProperty("--route-loading-inline-top", `${offset}px`);
    }

    placeInlineVeil();
    paint();

    function paint() {
      const inline = runtime.mode === "inline" && runtime.inline;
      overlay.classList.toggle("is-active", runtime.active && !inline);
      runtime.inline?.classList.toggle("is-active", runtime.active && inline);
    }

    const show = () => {
      window.clearTimeout(runtime.showTimer);
      runtime.showTimer = 0;
      if (runtime.active) return;
      runtime.active = true;
      runtime.shownAt = performance.now();
      paint();
      window.clearTimeout(runtime.maxTimer);
      runtime.maxTimer = window.setTimeout(hide, MAX_VISIBLE);
    };

    function hide() {
      window.clearTimeout(runtime.showTimer);
      window.clearTimeout(runtime.maxTimer);
      runtime.showTimer = 0;
      if (!runtime.active) {
        runtime.mode = "overlay";
        paint();
        return;
      }
      const remaining = MIN_VISIBLE - (performance.now() - runtime.shownAt);
      window.clearTimeout(runtime.hideTimer);
      const finish = () => {
        runtime.active = false;
        runtime.mode = "overlay";
        paint();
      };
      if (remaining > 0) runtime.hideTimer = window.setTimeout(finish, remaining);
      else finish();
    }

    function onVisitStart(visit) {
      // swup v4 把触发的元素放在 visit.trigger.el；旧版/插件可能给 visit.anchor。
      const anchor = visit?.trigger?.el ?? visit?.anchor ?? null;
      runtime.mode =
        runtime.inline && anchor?.closest?.(INLINE_SELECTOR) ? "inline" : "overlay";
      if (runtime.mode === "inline") placeInlineVeil();
      if (runtime.active) paint();
      window.clearTimeout(runtime.showTimer);
      runtime.showTimer = window.setTimeout(show, SHOW_DELAY);
    }

    runtime.show = show;
    runtime.hide = hide;

    if (!runtime.bound) {
      runtime.bound = true;
      const bindHooks = () => {
        if (!window.swup?.hooks) return false;
        window.swup.hooks.on("visit:start", onVisitStart);
        window.swup.hooks.on("visit:end", hide);
        window.swup.hooks.on("visit:abort", hide);
        return true;
      };
      if (!bindHooks()) {
        document.addEventListener("swup:enable", bindHooks, { once: true });
      }
      document.addEventListener("swup:page:view", hide);
      document.addEventListener("astro:page-load", hide);
    }
  })();
</script>

<style>
  .route-loading-overlay {
    position: fixed;
    inset: 0;
    z-index: 1002;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--page-bg);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition:
      opacity 160ms ease,
      visibility 0s linear 160ms;
  }

  .route-loading-overlay.is-active {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transition:
      opacity 140ms ease,
      visibility 0s;
  }

  .route-loading-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    transform: translateY(14px) scale(0.94);
    transition: transform 360ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .route-loading-overlay.is-active .route-loading-inner {
    transform: none;
  }

  .route-loading-text {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.34em;
    text-transform: lowercase;
    color: color-mix(in oklab, var(--text-color) 46%, transparent);
    animation: route-loading-text-pulse 2.2s ease-in-out infinite;
  }

  .route-loading-overlay:not(.is-active) .route-loading-text {
    animation-play-state: paused;
  }

  @keyframes route-loading-text-pulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.5;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .route-loading-overlay,
    .route-loading-overlay.is-active {
      transition: none;
    }

    .route-loading-inner,
    .route-loading-overlay.is-active .route-loading-inner {
      transform: none;
      transition: none;
    }

    .route-loading-text {
      animation: none;
    }
  }
</style>

<style is:global>
  /* 中间内容列的局部加载层：只有一堆小猫，不铺任何底色，旧内容照常可见。 */
  #main-column-shell {
    position: relative;
  }

  .route-loading-inline {
    position: absolute;
    /* 分类栏在切页动画里会整体下移 2rem，多加这点余量保证小猫始终在栏下方 */
    top: calc(var(--route-loading-inline-top, 59px) + 2.4rem);
    left: 50%;
    transform: translateX(-50%);
    z-index: 20;
    --route-loading-cat-size: 180px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition:
      opacity 150ms ease,
      visibility 0s linear 150ms;
  }

  .route-loading-inline.is-active {
    opacity: 1;
    visibility: visible;
    transition:
      opacity 130ms ease,
      visibility 0s;
  }

  .route-loading-inline .route-loading-text {
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.34em;
    text-transform: lowercase;
    color: color-mix(in oklab, var(--text-color) 46%, transparent);
    animation: route-loading-inline-text-pulse 2.2s ease-in-out infinite;
  }

  .route-loading-inline:not(.is-active) .route-loading-text {
    animation-play-state: paused;
  }

  @keyframes route-loading-inline-text-pulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.5;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .route-loading-inline,
    .route-loading-inline.is-active {
      transition: none;
    }

    .route-loading-inline .route-loading-text {
      animation: none;
    }
  }
</style>
