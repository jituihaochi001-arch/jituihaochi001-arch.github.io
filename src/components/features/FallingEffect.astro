---
import { fallingEffectConfig, sakuraConfig } from "@/config";

const baseUrl = import.meta.env.BASE_URL;
---

<script is:inline type="application/json" id="tasty-chicken-falling-effect-config" set:html={JSON.stringify({ fallingEffectConfig, sakuraConfig, baseUrl }).replace(/</g, "\u003c")} />
<script>
	void import("@/scripts/falling-effect");
</script>
