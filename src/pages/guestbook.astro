---
import { getEntry } from "astro:content";
import { Icon } from "astro-icon/components";
import { siteConfig } from "@/config";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import MainGridLayout from "@/layouts/MainGridLayout.astro";

// 检查页面是否启用
if (!siteConfig.pages.guestbook) {
	return Astro.redirect("/404/");
}

const guestbookPost = await getEntry("spec", "guestbook");

if (!guestbookPost) {
	throw new Error("guestbook page content not found");
}

// 每行一条留言（Markdown 引用），单条最多展示 15 个字
const notes = (guestbookPost.body ?? "")
	.split(/\r?\n/)
	.map((line) => line.trim())
	.filter((line) => line.startsWith(">"))
	.map((line) => line.replace(/^>\s?/, "").trim())
	.filter(Boolean)
	.map((text) => [...text].slice(0, 15).join(""));

// 页面标题和描述
const title = i18n(I18nKey.guestbook);
const greeting = i18n(I18nKey.guestbookDescription);

const skins = ["rose", "butter", "mint", "sky", "peach"];
const tilts = [-1.2, 0.9, -0.7, 1.3, -0.4, 1.1];
const shifts = ["-0.4rem", "0.8rem", "-0.9rem", "1.1rem", "0.2rem", "-0.6rem"];
---

<MainGridLayout title={title} description={greeting}>
  <div
    class="guestbook-shell flex w-full rounded-(--radius-large) overflow-hidden relative min-h-32"
  >
    <div
      class="guestbook-card card-base z-10 px-6 py-7 md:px-9 md:py-8 relative w-full"
    >
      <!-- 页面标题和描述 -->
      <header class="guestbook-head">
        <div class="guestbook-badge" aria-hidden="true">
          <Icon
            is:inline
            name="material-symbols:sticky-note-2"
            class="text-[1.45rem]"
          />
        </div>
        <div class="guestbook-head__text">
          <h1 class="guestbook-title">{title}</h1>
          {greeting && <p class="guestbook-greeting">{greeting}</p>}
        </div>
      </header>

      <!-- 黑板留言墙：纯展示，不开放提交 -->
      <section class="board" aria-label={title}>
        <div class="board__surface">
          {
            notes.length > 0 ? (
              <ul class="notes">
                {notes.map((text, index) => (
                  <li
                    class:list={[
                      "note",
                      `note--${skins[index % skins.length]}`,
                    ]}
                    style={`--tilt:${tilts[index % tilts.length]}deg; --shift:${shifts[index % shifts.length]};`}
                  >
                    <span class="note__text">{text}</span>
                  </li>
                ))}
              </ul>
            ) : (
              <p class="board__empty">还没有留言，黑板先空着。</p>
            )
          }
        </div>
        <div class="board__tray" aria-hidden="true">
          <span class="chalk"></span>
          <span class="chalk chalk--pink"></span>
        </div>
      </section>
    </div>
  </div>
</MainGridLayout>

<style>
  /* pure 主题下标题由卡片内承担，避免出现两个「留言板」 */
  :global(
    html[data-site-theme="pure"]
      .pure-page[data-pure-page="guestbook"]
      .pure-page-title
  ) {
    display: none;
  }

  .guestbook-head {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }

  .guestbook-badge {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: none;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 0.65rem;
    background: var(--primary);
    color: #fff;
  }

  :global(.dark) .guestbook-badge {
    color: rgba(0, 0, 0, 0.72);
  }

  .guestbook-title {
    font-size: clamp(1.6rem, 3vw, 1.9rem);
    line-height: 1.25;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--text-color);
    text-wrap: balance;
  }

  .guestbook-greeting {
    margin-top: 0.2rem;
    font-size: 0.95rem;
    line-height: 1.5;
    color: var(--text-color);
    opacity: 0.68;
  }

  .guestbook-shell {
    min-height: 0;
  }

  .guestbook-card {
    display: flex;
    flex-direction: column;
  }

  /* 让黑板占据首屏大部分视觉空间 */
  @media (min-width: 1024px) {
    .guestbook-card {
      min-height: clamp(560px, calc(100dvh - 20rem), 800px);
    }
  }

  .board {
    display: flex;
    flex: 1;
    flex-direction: column;
    margin-top: 1.6rem;
    padding: 12px;
    border-radius: 18px 14px 20px 15px / 15px 20px 14px 18px;
    background: linear-gradient(
      145deg,
      #f8eedf 0%,
      #f0ddc4 42%,
      #f5e7d4 68%,
      #e7d1b1 100%
    );
    box-shadow:
      0 14px 30px -20px rgba(78, 96, 84, 0.42),
      inset 0 1px 0 rgba(255, 255, 255, 0.7),
      inset 0 -2px 4px rgba(140, 113, 79, 0.16);
  }

  .board__surface {
    position: relative;
    display: flex;
    flex: 1;
    flex-direction: column;
    justify-content: center;
    min-height: clamp(340px, 46dvh, 560px);
    padding: clamp(1.6rem, 4vw, 2.8rem);
    border-radius: 10px 14px 9px 12px / 12px 9px 14px 10px;
    background-color: #2e4636;
    background-image: url("/assets/images/guestbook/blackboard.webp");
    background-position: center;
    background-size: cover;
    box-shadow:
      inset 0 0 0 1px rgba(0, 0, 0, 0.42),
      inset 0 0 70px rgba(0, 0, 0, 0.3);
    overflow: hidden;
  }

  /* 手绘感的粉笔内框 */
  .board__surface::before {
    content: "";
    position: absolute;
    inset: 12px;
    border: 1.5px dashed rgba(255, 255, 255, 0.22);
    border-radius: 10px 14px 9px 12px / 12px 9px 14px 10px;
    pointer-events: none;
  }

  .board__tray {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: flex-start;
    gap: 0.45rem;
    height: 14px;
    margin: 0 -12px -12px;
    padding: 2px 1.5rem 0;
    border-radius: 0 0 17px 13px;
    background: linear-gradient(180deg, #eedcc3, #dcc3a1);
    box-shadow: inset 0 2px 3px rgba(140, 113, 79, 0.22);
  }

  .chalk {
    display: block;
    width: 48px;
    height: 6px;
    border-radius: 3px;
    background: #fdf8ec;
    box-shadow: 0 1px 0 rgba(140, 113, 79, 0.2);
  }

  .chalk--pink {
    width: 30px;
    background: #f5b8c4;
  }

  .notes {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .note {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: fit-content;
    min-width: min(300px, 100%);
    max-width: min(100%, 560px);
    padding: 0.78rem 1.5rem 0.82rem;
    border-radius: 4px 6px 3px 5px / 5px 3px 6px 4px;
    background-color: var(--paper);
    background-image: repeating-linear-gradient(
      45deg,
      rgba(255, 255, 255, 0.25) 0 2px,
      transparent 2px 7px
    );
    color: var(--ink);
    text-align: center;
    font-size: clamp(0.95rem, 1.4vw, 1.05rem);
    font-weight: 700;
    line-height: 1.5;
    letter-spacing: 0.02em;
    overflow-wrap: anywhere;
    transform: translateX(var(--shift)) rotate(var(--tilt));
    box-shadow:
      inset 0 0 0 1px rgba(255, 255, 255, 0.3),
      2px 4px 10px rgba(56, 82, 66, 0.18);
    transition:
      transform 0.3s cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* 纸条顶部的胶带 */
  .note::before {
    content: "";
    position: absolute;
    top: -8px;
    left: 50%;
    width: 52px;
    height: 15px;
    transform: translateX(-50%) rotate(-2.5deg);
    border: 1px solid rgba(255, 255, 255, 0.55);
    border-radius: 1px;
    background: rgba(255, 249, 235, 0.8);
    box-shadow: 0 1px 3px rgba(90, 110, 95, 0.18);
  }

  .note--rose {
    --paper: rgba(255, 150, 165, 0.95);
    --ink: #5a1020;
  }

  .note--butter {
    --paper: rgba(255, 210, 80, 0.95);
    --ink: #553500;
  }

  .note--mint {
    --paper: rgba(144, 211, 173, 0.95);
    --ink: #174b38;
  }

  .note--sky {
    --paper: rgba(135, 190, 236, 0.95);
    --ink: #173b61;
  }

  .note--peach {
    --paper: rgba(246, 184, 98, 0.95);
    --ink: #5b3510;
  }

  .note:hover,
  .note:focus-visible {
    z-index: 2;
    transform: translateX(var(--shift)) rotate(0deg) translateY(-2px);
    box-shadow:
      inset 0 0 0 1px rgba(255, 255, 255, 0.35),
      3px 7px 16px rgba(56, 82, 66, 0.24);
  }

  .board__empty {
    position: relative;
    z-index: 1;
    padding: 3.5rem 0;
    text-align: center;
    font-size: 0.95rem;
    color: rgba(255, 255, 255, 0.55);
    letter-spacing: 0.08em;
  }

  @media (max-width: 640px) {
    .board {
      padding: 8px;
      border-radius: 14px 11px 16px 12px / 12px 16px 11px 14px;
    }

    .board__surface {
      min-height: clamp(300px, 52dvh, 440px);
      padding: 1.25rem 1rem;
    }

    .board__tray {
      margin: 0 -8px -8px;
      padding-left: 1rem;
    }

    .notes {
      gap: 0.9rem;
    }

    .note {
      min-width: min(250px, 100%);
      padding: 0.7rem 1.1rem 0.74rem;
      font-size: 0.92rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .note {
      transition: none;
    }

    .note:hover,
    .note:focus-visible {
      transform: translateX(var(--shift)) rotate(var(--tilt));
    }
  }
</style>
